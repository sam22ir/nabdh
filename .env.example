# Convex deployment used by `npx convex dev`.
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Public Convex URL consumed by the Expo app.
EXPO_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Clerk publishable key consumed by the Expo app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-with-your-clerk-publishable-key

# Public Sentry DSN consumed by the Expo app. Leave blank to disable Sentry locally.
EXPO_PUBLIC_SENTRY_DSN=

# Sentry build/API settings. Keep SENTRY_AUTH_TOKEN only in your local env or EAS secrets.
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=

# Clerk Frontend API URL from the Clerk Convex integration page.
# Set this in Convex with `npx convex env set CLERK_JWT_ISSUER_DOMAIN <url>`.
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-frontend-api-url
