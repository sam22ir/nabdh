# Supabase project (Settings -> API). The publishable key is safe in the app;
# access is enforced by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://oeexmfgpfotimfsqkntp.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SzpiWQPIRf5bBvn3X43cpw_CGloNYDU

# Google Cloud -> Credentials -> OAuth client ID of type "Web application".
# The same Web client ID + secret are entered in Supabase (Authentication ->
# Providers -> Google). The Android client (package com.nabdh.app + SHA-1)
# only needs to exist in Google Cloud.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Public Sentry DSN consumed by the Expo app. Leave blank to disable Sentry locally.
EXPO_PUBLIC_SENTRY_DSN=

# Sentry build/API settings. Keep SENTRY_AUTH_TOKEN only in your local env or EAS secrets.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
