# Convex deployment used by `npx convex dev`.
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Public Convex URL consumed by the Expo app.
EXPO_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Convex Auth issuer/site URL used by convex/auth.config.ts and @convex-dev/auth.
CONVEX_SITE_URL=https://your-project.convex.site

# Convex Auth signing keys. Generate and set real values with the Convex Auth CLI.
# Never commit real key material.
JWT_PRIVATE_KEY="replace-with-generated-private-key"
JWKS='{"keys":[]}'
